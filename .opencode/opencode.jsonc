{
  "$schema": "https://opencode.ai/config.json",
  "lsp": {
    "ruff": {
      "command": ["uv", "run", "ruff", "server"],
      "extensions": [".py"],
      "disabled": false,
    },
    "pyrefly": {
      "command": ["uv", "run", "pyrefly", "lsp"],
      "extensions": [".py"],
      "disabled": false,
    },
    "ty": {
      "disabled": true,
    },
    "pyright": {
      "disabled": true,
    },
  },
}
